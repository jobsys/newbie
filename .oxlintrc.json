{
	"env": {
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"no-console": "off",
		"no-debugger": "warn",
		"no-undef": "error",
		"import/no-unassigned-import": [
			"warn",
			{
				"allow": [
					"**/*.css",
					"**/*.less",
					"**/*.scss"
				]
			}
		],
		"no-underscore-dangle": [
			"warn",
			{
				"allow": [
					"_type",
					"_disk",
					"_configStatus",
					"__name",
					"__quiz_answer",
					"__quiz_analysis"
				]
			}
		]
	},
	"categories": {
		"correctness": "error",
		"perf": "warn",
		"style": "off",
		"suspicious": "warn"
	},
	"ignorePatterns": [
		"node_modules/",
		"dist/",
		".git/",
		".github/",
		"coverage/",
		".vite/",
		".rolldown/",
		".cache/",
		"playground/"
	],
	"plugins": [
		"import",
		"node",
		"unicorn"
	],
	"settings": {
		"import/resolver": {
			"node": {
				"extensions": [
					".js",
					".jsx",
					".ts",
					".tsx",
					".vue"
				]
			}
		}
	}
}
